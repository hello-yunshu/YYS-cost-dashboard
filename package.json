{
  "name": "cost-dashboard",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:frontend": "vite",
    "dev:server": "node server/index.js",
    "build": "npm run build:frontend && npm run build:server",
    "build:frontend": "vite build",
    "build:server": "node build-server.js",
    "build:portable": "node build-portable.js",
    "build:win": "node build-portable.js --platform win-x64",
    "build:macos": "node build-portable.js --platform macos-arm64,macos-x64 && bash launcher/macos/build-macos-dmg.sh",
    "build:android": "bash launcher/android/build-android-apk.sh",
    "build:launcher:win": "powershell -NoProfile -ExecutionPolicy Bypass -File launcher/windows/build-windows-launcher.ps1",
    "build:launcher:macos": "bash launcher/macos/build-macos-launcher.sh",
    "build:dmg": "bash launcher/macos/build-macos-dmg.sh",
    "build:docker": "docker compose build",
    "start": "node server/index.js",
    "start:docker": "docker compose up -d",
    "stop:docker": "docker compose down",
    "seed": "node server/db/seed.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@tailwindcss/postcss": "^4.3.0",
    "axios": "^1.16.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dayjs": "^1.11.20",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "pdfmake": "^0.3.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "sql.js": "^1.14.1",
    "xlsx": "npm:@e965/xlsx@0.20.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0"
  },
  "overrides": {
    "size-sensor": "1.0.3"
  }
}
