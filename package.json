{
  "name": "cost-dashboard",
  "version": "2.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:frontend": "vite",
    "dev:server": "node server/index.js",
    "build": "npm run build:frontend && npm run build:server",
    "build:frontend": "vite build",
    "build:server": "node build-server.js",
    "build:portable": "node build-portable.js",
    "build:portable:win": "node build-portable.js --platform win-x64",
    "build:launcher:win": "powershell -NoProfile -ExecutionPolicy Bypass -File launcher/build-windows-launcher.ps1",
    "build:docker": "docker compose build",
    "start": "node server/index.js",
    "start:docker": "docker compose up -d",
    "stop:docker": "docker compose down",
    "seed": "node server/db/seed.js"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.11",
    "echarts": "^5.5.0",
    "echarts-for-react": "^3.0.2",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "pdfmake": "^0.3.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "sql.js": "^1.10.3",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^7.0"
  }
}
